# ── GBONHI FOOT — Variables d'environnement ───────────────────────────────
# Copier en .env et remplir les valeurs. NE JAMAIS commiter .env

# ── SUPABASE (supabase.com → project settings → API) ────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_JWT_SECRET=your-jwt-secret

# ── DATABASE (Supabase → settings → Database) ────────────────────────────
DATABASE_URL=postgresql://postgres.[ref]:[pwd]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.[ref]:[pwd]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# ── CINETPAY (cinetpay.com → mon compte → API) ───────────────────────────
CINETPAY_API_KEY=your-cinetpay-api-key
CINETPAY_SITE_ID=your-site-id

# ── URLS PRODUCTION ───────────────────────────────────────────────────────
ADMIN_URL=https://gbonhi-foot-admin.onrender.com
PARTNER_URL=https://gbonhi-foot-partner.onrender.com
API_URL=https://gbonhi-foot-api.onrender.com
CINETPAY_NOTIFY_URL=https://gbonhi-foot-api.onrender.com/api/v1/payments/webhook

# ── MOBILE (préfixe EXPO_PUBLIC_ = exposé côté client) ───────────────────
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...
EXPO_PUBLIC_API_URL=https://gbonhi-foot-api.onrender.com/api/v1

# ── WEB PORTAILS (préfixe NEXT_PUBLIC_ = exposé côté client) ─────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
NEXT_PUBLIC_API_URL=https://gbonhi-foot-api.onrender.com/api/v1

# ── DEV LOCAL ─────────────────────────────────────────────────────────────
PORT=8000
NODE_ENV=development
