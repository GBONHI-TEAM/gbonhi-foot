# Copier vers .env et remplir avec les valeurs du projet (jamais de secret ici :
# les IDs client OAuth Google sont des identifiants publics).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_URL=

# Connexion Google native (voir src/lib/auth-google.ts)
# ID client OAuth « Web » existant (celui du provider Google dans Supabase)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# ID client OAuth « iOS » (Google Cloud → Clients → iOS, bundle com.genius21.gbonhifoot)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
