# Database (Supabase pooler URL - the runtime automatically uses transaction mode)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Paiements : simulation activée jusqu'à réception des API Mobile Money.
PAYMENT_SIMULATION_ENABLED=true

# CinetPay - conserver les clés hors du dépôt. Aucun appel CinetPay n'est
# effectué tant que la simulation est activée.
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
# Public HTTPS origin reachable by CinetPay for /api/v1/payments/cinetpay/notify.
PAYMENT_PUBLIC_API_URL=https://api.gbonhifoot.com

# Wave Checkout API (https://docs.wave.com/checkout). Tout reste INACTIF tant
# que WAVE_API_KEY est vide (aucun appel sortant). À renseigner une fois les
# clés obtenues auprès de l'agrégateur / Wave Business.
WAVE_API_KEY=
WAVE_API_BASE=https://api.wave.com
# Secret de signature des webhooks (vérification HMAC du corps brut).
WAVE_WEBHOOK_SECRET=
# Optionnel : signature des requêtes sortantes si activée sur la clé API.
WAVE_SIGNING_SECRET=
# Requis uniquement pour les comptes « agrégateur » (sinon laisser vide).
WAVE_AGGREGATED_MERCHANT_ID=
# Pages de redirection après paiement (HTTPS). L'app mobile peut aussi fournir
# ses propres URLs ; à défaut on utilise celles-ci.
WAVE_SUCCESS_URL=https://gbonhifoot.com/paiement/succes
WAVE_ERROR_URL=https://gbonhifoot.com/paiement/echec

PORT=3001
NODE_ENV=development
