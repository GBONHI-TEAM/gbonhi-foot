# Database (Supabase pooler URL - the runtime automatically uses transaction mode)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Paiements : simulation activée jusqu'à réception des API Mobile Money.
PAYMENT_SIMULATION_ENABLED=true

# CinetPay - conserver les clés hors du dépôt. Aucun appel CinetPay n'est
# effectué tant que la simulation est activée.
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
# Public HTTPS origin reachable by CinetPay for /api/v1/payments/cinetpay/notify.
PAYMENT_PUBLIC_API_URL=https://gbonhi-foot-api.onrender.com

PORT=3001
NODE_ENV=development
